# Normalise to LF in the repository. Without this, Windows checkouts commit CRLF
# and compile-check.sh fails on a Linux or macOS runner with "\r: command not
# found" — which is the kind of bug that only shows up in CI.
* text=auto eol=lf

*.sh   text eol=lf
*.bat  text eol=crlf
*.cmd  text eol=crlf

*.kt     text eol=lf
*.swift  text eol=lf
*.m      text eol=lf
*.java   text eol=lf
*.gradle text eol=lf

*.jar        binary
*.aar        binary
*.keystore   binary
*.png        binary
*.zip        binary
